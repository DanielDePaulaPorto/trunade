// Copie estes blocos para ~/.config/zed/keymap.json.
[
  {
    "context": "Editor && extension == md",
    "bindings": {
      "cmd-. r": "repl::Run",
      "cmd-. enter": "repl::RunInPlace",
      "cmd-. c": "repl::ClearCurrentOutput",
      "cmd-. shift-c": "repl::ClearOutputs",
      "cmd-. i": "repl::Interrupt",
      "cmd-. k": "repl::Restart",
      "cmd-. s": "repl::Sessions",
      "cmd-. t": ["task::Spawn", { "task_name": "Trunade: run block" }],
      "cmd-. p": ["task::Spawn", { "task_name": "Trunade: pick block" }],
      "cmd-. d": ["task::Spawn", { "task_name": "Trunade: probe" }]
    }
  },
  {
    // No preview não há REPL; só as tasks de terminal.
    "context": "MarkdownPreview",
    "bindings": {
      "cmd-. t": ["task::Spawn", { "task_name": "Trunade: run block" }],
      "cmd-. p": ["task::Spawn", { "task_name": "Trunade: pick block" }],
      "cmd-. d": ["task::Spawn", { "task_name": "Trunade: probe" }]
    }
  },
]
