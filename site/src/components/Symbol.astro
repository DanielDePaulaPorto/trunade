---
/*
 * The animated symbol (brand book: animated symbol). States are classes
 * on the <svg>: none (idle, `_` blinks), `is-running`, `is-reset`.
 * Each instance needs its own gradient id: repeated ids resolve to the first.
 */
interface Props {
  id: string
  size?: number
  running?: boolean
  class?: string
  style?: string
}

const { id, size = 64, running = false, class: className, style } = Astro.props
const gradient = `trn-g-${id}`
---

<svg
  id={id}
  class:list={['trn', className, { 'is-running': running }]}
  style={style}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="Trunade!"
>
  <linearGradient id={gradient} gradientUnits="userSpaceOnUse" x1="9.05" y1="18.75" x2="44.03" y2="8.39">
    <stop offset="0" stop-opacity=".16"></stop>
    <stop offset=".55" stop-opacity=".6"></stop>
    <stop offset="1"></stop>
  </linearGradient>
  <g class="trn-rotor" stroke={`url(#${gradient})`}>
    <path d="M9.05 18.75A26.5 26.5 0 0 1 44.03 8.39"></path>
    <path d="M9.05 18.75A26.5 26.5 0 0 1 44.03 8.39" transform="rotate(120 32 32)"></path>
    <path d="M9.05 18.75A26.5 26.5 0 0 1 44.03 8.39" transform="rotate(240 32 32)"></path>
  </g>
  <path
    class="trn-skull"
    d="M23.5 36.95A8.5 8.5 0 0 1 18 29V25a8.5 8.5 0 0 1 8.5 -8.5H37.5a8.5 8.5 0 0 1 8.5 8.5V29A8.5 8.5 0 0 1 40.5 36.95V46.5H35.78V41.9H33.88V46.5H30.12V41.9H28.22V46.5H23.5Z"
  ></path>
  <path class="trn-eye" d="M22.2 22.5h3.4L30.2 27.6L25.6 32.7h-3.4L26.8 27.6Z"></path>
  <path class="trn-eye trn-cursor" d="M33.6 30.1h8.4v2.6h-8.4Z"></path>
</svg>
