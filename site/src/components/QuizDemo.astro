---
/* The ```quiz block as the lesson page shows it: pick, then reveal. */
const options = [
  { text: 'O(n)', correct: false },
  { text: 'O(log n)', correct: true },
  { text: 'O(n log n)', correct: false },
  { text: 'O(1)', correct: false },
]
---

<div class="quiz" data-quiz>
  <p class="quiz-question">Qual a complexidade da busca binária num vetor ordenado?</p>
  <ul role="radiogroup" aria-label="Opções">
    {options.map((option) => (
      <li>
        <button type="button" role="radio" aria-checked="false" data-correct={option.correct ? '' : undefined}>
          <span class="mark" aria-hidden="true"></span>
          <code>{option.text}</code>
        </button>
      </li>
    ))}
  </ul>
  <button class="reveal" type="button" data-reveal>Ver resposta</button>
</div>

<script>
  for (const quiz of document.querySelectorAll<HTMLElement>('[data-quiz]')) {
    const options = [...quiz.querySelectorAll<HTMLButtonElement>('[role=radio]')]
    for (const option of options) {
      option.addEventListener('click', () => {
        if (quiz.classList.contains('revealed')) return
        for (const other of options) other.setAttribute('aria-checked', String(other === option))
      })
    }
    quiz.querySelector('[data-reveal]')!.addEventListener('click', (event) => {
      const revealed = quiz.classList.toggle('revealed')
      ;(event.currentTarget as HTMLElement).textContent = revealed ? 'Tentar de novo' : 'Ver resposta'
      if (!revealed) for (const option of options) option.setAttribute('aria-checked', 'false')
    })
  }
</script>

<style>
  .quiz {
    padding: var(--space-24);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
  }

  .quiz-question {
    margin: 0 0 var(--space-16);
    font-weight: 700;
  }

  ul {
    display: grid;
    gap: var(--space-8);
    margin: 0 0 var(--space-16);
    padding: 0;
    list-style: none;
  }

  [role='radio'] {
    display: flex;
    gap: 12px;
    align-items: center;
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  [role='radio'][aria-checked='true'] {
    border: 2px solid var(--ink);
    padding: 9px 13px;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 700;
  }

  [aria-checked='true'] .mark::before {
    content: '>';
  }

  .revealed [data-correct] {
    border-color: var(--malachite);
  }

  .revealed [data-correct] .mark {
    border-color: var(--malachite);
    background: var(--malachite);
    color: var(--on-malachite);
  }

  .revealed [data-correct] .mark::before {
    content: '✓';
  }

  .revealed [aria-checked='true']:not([data-correct]) .mark {
    border-color: var(--bronze);
    color: var(--bronze);
  }

  .revealed [aria-checked='true']:not([data-correct]) .mark::before {
    content: '✗';
  }

  .reveal {
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--ink);
    font: 700 14px/1 var(--font-mono);
    cursor: pointer;
  }
</style>
