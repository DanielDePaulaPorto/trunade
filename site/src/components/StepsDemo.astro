---
/* `<!-- step: … -->` markers as the lesson page shows them. */
const steps = [
  { title: 'Enunciado', body: 'Leia <code>n</code> inteiros e imprima o maior.' },
  { title: 'Dica', body: 'Comece com o primeiro valor lido, não com <code>0</code>: os números podem ser negativos.' },
  {
    title: 'Solução',
    body: '<code>int m = v[0]; for (int x : v) m = std::max(m, x);</code><br>No Trunade!, este passo é um bloco que roda.',
  },
]
---

<div class="steps" data-steps>
  <ol class="track">
    {steps.map((step, index) => (
      <li>
        <button type="button" data-goto={index} aria-current={index === 0 ? 'step' : undefined}>
          <span class="dot">{index + 1}</span>{step.title}
        </button>
      </li>
    ))}
  </ol>
  {steps.map((step, index) => (
    <div class="panel" data-panel={index} hidden={index !== 0} set:html={step.body} />
  ))}
  <div class="nav">
    <button type="button" data-move="-1" disabled>Anterior</button>
    <span class="progress" data-progress>Passo 1 de {steps.length}</span>
    <button type="button" data-move="1">Próximo</button>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-steps]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')]
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')]
    const [back, next] = [...root.querySelectorAll<HTMLButtonElement>('[data-move]')]
    const progress = root.querySelector<HTMLElement>('[data-progress]')!
    let current = 0

    const show = (index: number) => {
      current = index
      tabs.forEach((tab, i) => {
        tab.toggleAttribute('data-done', i < index)
        if (i === index) tab.setAttribute('aria-current', 'step')
        else tab.removeAttribute('aria-current')
      })
      panels.forEach((panel, i) => (panel.hidden = i !== index))
      back!.disabled = index === 0
      next!.disabled = index === panels.length - 1
      progress.textContent = `Passo ${index + 1} de ${panels.length}`
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)))
    back!.addEventListener('click', () => show(current - 1))
    next!.addEventListener('click', () => show(current + 1))
  }
</script>

<style>
  .steps {
    padding: var(--space-24);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
  }

  .track {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0 0 var(--space-16);
    padding: 0;
    list-style: none;
  }

  .track button {
    display: flex;
    gap: var(--space-8);
    align-items: center;
    padding: 4px 10px 4px 4px;
    border: 0;
    border-radius: 99px;
    background: transparent;
    color: var(--muted);
    font: 700 14px/1 var(--font-mono);
    cursor: pointer;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
  }

  .track [aria-current='step'] {
    color: var(--ink);
  }

  .track [aria-current='step'] .dot,
  .track [data-done] .dot {
    border-color: var(--malachite);
    background: var(--malachite);
    color: var(--on-malachite);
  }

  .panel {
    min-height: 5.5em;
    padding: var(--space-16);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .nav {
    display: flex;
    gap: var(--space-16);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-16);
  }

  .nav button {
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--ink);
    font: 700 14px/1 var(--font-mono);
    cursor: pointer;
  }

  .nav button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .progress {
    color: var(--muted);
    font-size: 13px;
  }
</style>
