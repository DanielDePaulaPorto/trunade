---
import Base from '../layouts/Base.astro'
import Symbol from '../components/Symbol.astro'
import RunDemo from '../components/RunDemo.astro'
import QuizDemo from '../components/QuizDemo.astro'
import StepsDemo from '../components/StepsDemo.astro'

const steps = [
  {
    glyph: '01',
    title: 'Escreva',
    text: 'A aula é um arquivo Markdown no seu editor. Bloco <code>cpp</code> vira programa; o resto é texto.',
  },
  {
    glyph: '02',
    title: 'Rode',
    text: '<code>trunade aula.md</code> abre a aula no navegador. Salvou no editor, a página atualiza.',
  },
  {
    glyph: '03',
    title: 'Projete',
    text: 'Cada bloco tem ▶. Compila com o g++ de verdade e a saída aparece num terminal logo abaixo.',
  },
]

const features = [
  { glyph: '$', title: 'Compilador de verdade', text: 'g++-16 por padrão, com as flags que você escolher por bloco. Erro de compilação aparece inteiro e colorido.' },
  { glyph: '>_', title: 'cin interativo', text: 'Sem bloco de entrada, o programa roda num terminal real e a turma digita na hora. Com <code>stdin</code>, a entrada vai junto com a aula.' },
  { glyph: '!', title: 'Erros que ensinam', text: 'Código de saída, <code>Segmentation fault</code>, tempo limite e limite de saída aparecem embaixo do programa.' },
  { glyph: '∑', title: 'Fórmulas e diagramas', text: 'LaTeX com <code>$…$</code> e diagramas Mermaid, renderizados no navegador, sem internet.' },
  { glyph: '?', title: 'Perguntas', text: 'Um bloco <code>quiz</code> vira pergunta de uma ou várias respostas, revelada quando você quiser.' },
  { glyph: '→', title: 'Exercício em passos', text: 'Enunciado, dica e solução atrás de marcadores. O código da solução continua rodando.' },
  { glyph: '[]', title: 'Páginas embutidas', text: 'Imagens, HTML e iframes ao lado do <code>.md</code>. Sites largos são reduzidos para caber.' },
  { glyph: 'T', title: 'Navegação de palco', text: '<kbd>T</kbd> abre o índice, <kbd>espaço</kbd> rola até a próxima seção. Fonte e largura do texto no teclado.' },
  { glyph: '{ }', title: 'Edite sem medo', text: 'Mexa no código durante a aula. O arquivo não muda: recarregou, voltou para a mão.' },
]

const comparison = [
  ['Arquivo da aula', 'Markdown puro. Diff legível, abre em qualquer editor, não guarda saída.', '.ipynb em JSON, com saídas e metadados misturados ao texto.'],
  ['O que é um bloco', 'Um programa completo, com main(), como na prova e na maratona.', 'Uma célula que continua o estado das anteriores.'],
  ['Compilador', 'O real, com as suas flags.', 'O do kernel; em C++, código interpretado.'],
  ['Erros de execução', 'Código de saída, sinais, tempo limite e limite de saída.', 'Dependem do kernel; laço infinito trava a célula.'],
  ['Entrada padrão', 'Terminal interativo ou bloco stdin versionado.', 'Limitada; em C++ geralmente sem cin interativo.'],
  ['Em sala', 'Tema claro, fonte e largura no teclado, índice com T.', 'Interface de notebook, feita para editar.'],
  ['Instalação', 'Um binário. Funciona offline.', 'Python, Jupyter e um kernel de C++.'],
]

const shortcuts = [
  [['T'], 'índice de seções'],
  [['espaço', '↓'], 'próxima seção'],
  [['⇧ espaço', '↑'], 'seção anterior'],
  [['+', '−', '0'], 'fonte'],
  [['W'], 'largura do texto'],
  [['F'], 'tela cheia'],
  [['D'], 'tema claro ou escuro'],
  [['O'], 'configurações'],
  [['⇧ Enter'], 'rodar o bloco'],
]
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label">Aulas de programação em Markdown</p>
        <h1>Compile, rode, apague e rode de novo. <span class="accent">Sem medo.</span></h1>
        <p class="lead">
          Escreva a aula em Markdown. Cada bloco de código ganha um botão ▶ que compila com o g++ de verdade e mostra a
          saída num terminal, ali mesmo, no telão.
        </p>
        <div class="command" data-copy="trunade aula.md">
          <code><span class="prompt">$</span> trunade aula.md</code>
          <button type="button" class="copy" aria-label="Copiar o comando">copiar</button>
        </div>
        <div class="actions">
          <a class="button" href="/docs/instalacao/">Instalar</a>
          <a class="button ghost" href="/docs/">Ler a documentação</a>
        </div>
      </div>
      <div class="hero-demo">
        <RunDemo />
        <p class="hint">Aperte ▶ e digite seu nome no terminal.</p>
      </div>
    </div>
  </section>

  <section class="wrap section how" aria-labelledby="como">
    <h2 id="como">Um arquivo, um comando, uma aula.</h2>
    <ol class="how-steps">
      {steps.map((step) => (
        <li>
          <span class="how-number">{step.glyph}</span>
          <h3>{step.title}</h3>
          <p set:html={step.text} />
        </li>
      ))}
    </ol>
    <div class="source">
      <div class="source-file">
        <span class="label">aula-02.md</span>
        <pre><code><span class="md-h">## Lendo do teclado</span>

Use <span class="md-c">`std::cin`</span> para ler da entrada padrão.

<span class="md-f">```cpp {"{"}flags="-O2"{"}"}</span>
int main() {"{"} int a, b; std::cin &gt;&gt; a &gt;&gt; b;
             std::cout &lt;&lt; a + b &lt;&lt; "\n"; {"}"}
<span class="md-f">```</span>

<span class="md-f">```stdin</span>
2 40
<span class="md-f">```</span></code></pre>
      </div>
      <p class="source-note">
        <strong>Sem formato novo.</strong> O que não é bloco de código continua sendo Markdown comum: títulos, listas, tabelas,
        imagens e HTML. Abre no GitHub, no Zed, no VS Code e no Vim do mesmo jeito.
      </p>
    </div>
  </section>

  <section class="band" id="recursos" aria-labelledby="recursos-titulo">
    <div class="wrap section">
      <h2 id="recursos-titulo">Feito para a sala, não para o notebook.</h2>
      <ul class="features">
        {features.map((feature) => (
          <li>
            <span class="glyph" aria-hidden="true">{feature.glyph}</span>
            <h3>{feature.title}</h3>
            <p set:html={feature.text} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="interacao">
    <h2 id="interacao">A turma participa.</h2>
    <p class="section-lead">Perguntas e exercícios em passos são blocos do próprio Markdown. Experimente:</p>
    <div class="pair">
      <div>
        <QuizDemo />
        <pre class="snippet"><code>```quiz
Qual a complexidade da busca binária…?
- [ ] O(n)
- [x] O(log n)
```</code></pre>
      </div>
      <div>
        <StepsDemo />
        <pre class="snippet"><code>&lt;!-- step: Enunciado --&gt;
&lt;!-- step: Dica --&gt;
&lt;!-- step: Solução --&gt;
&lt;!-- /steps --&gt;</code></pre>
      </div>
    </div>
  </section>

  <section class="wrap section stage" aria-labelledby="palco">
    <div>
      <h2 id="palco">No telão, só o que importa.</h2>
      <p class="section-lead">
        Fundo branco para sala clara, tema escuro para a noite. Fonte e largura do texto mudam pelo teclado, e nenhuma barra de
        ferramentas disputa a atenção com o código.
      </p>
    </div>
    <dl class="keys">
      {shortcuts.map(([keys, label]) => (
        <>
          <dt>{(keys as string[]).map((key) => <kbd>{key}</kbd>)}</dt>
          <dd>{label}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="band" id="jupyter" aria-labelledby="jupyter-titulo">
    <div class="wrap section">
      <h2 id="jupyter-titulo">Por que não o Jupyter?</h2>
      <p class="section-lead">
        O Jupyter é ótimo quando o estado entre células é o ponto: dados, gráficos, exploração. Uma aula de C++ pede outra coisa.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th scope="col"><span class="sr">Aspecto</span></th><th scope="col">Trunade!</th><th scope="col">Jupyter</th></tr>
          </thead>
          <tbody>
            {comparison.map(([topic, trunade, jupyter]) => (
              <tr><th scope="row">{topic}</th><td>{trunade}</td><td class="muted">{jupyter}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>Um Jupyter só para rodar código: use o Trunade! quando cada exemplo for um programa.</p>
    </div>
  </section>

  <section class="wrap section eye" aria-labelledby="ciclone">
    <div class="eye-symbol">
      <Symbol id="eye" size={220} />
    </div>
    <div>
      <h2 id="ciclone">O olho do ciclone.</h2>
      <p>
        O crânio é uma janela de terminal com dentes, e os olhos são o prompt <code>&gt;_</code>. Em volta, um rotor de três arcos.
        Na página da aula ele é o indicador de execução:
      </p>
      <div class="states" role="group" aria-label="Estados do símbolo">
        <button type="button" data-state="" aria-pressed="true">parado</button>
        <button type="button" data-state="is-running" aria-pressed="false">rodando</button>
        <button type="button" data-state="is-reset" aria-pressed="false">reset</button>
      </div>
      <p class="state-text" data-state-text>Pronto para rodar: o <code>_</code> pisca como cursor.</p>
    </div>
  </section>

  <section class="wrap section cta" aria-labelledby="comecar">
    <h2 id="comecar">Sua próxima aula já é um arquivo Markdown.</h2>
    <pre class="install"><code><span class="prompt">$</span> brew install gcc        <span class="comment"># g++-16 no macOS</span>
<span class="prompt">$</span> TrunadeCode/install.sh
<span class="prompt">$</span> trunade aula.md</code></pre>
    <a class="button" href="/docs/instalacao/">Guia de instalação</a>
  </section>
</Base>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const button = box.querySelector('button')!
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(box.dataset.copy!)
        button.textContent = 'copiado'
      } catch {
        button.textContent = 'selecione e copie'
      }
      setTimeout(() => (button.textContent = 'copiar'), 1600)
    })
  }

  const STATE_TEXT: Record<string, string> = {
    '': 'Pronto para rodar: o <code>_</code> pisca como cursor.',
    'is-running': 'Compilando ou rodando: voltas completas, com arrancada e freio, e os olhos acesos.',
    'is-reset': 'Acabou: uma volta para trás. As cartas voltam para a mão.',
  }
  const eye = document.querySelector<SVGElement>('#eye')
  const stateText = document.querySelector<HTMLElement>('[data-state-text]')
  const stateButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-state]')]
  const setState = (state: string) => {
    eye?.classList.remove('is-running', 'is-reset')
    if (state) eye?.classList.add(state)
    for (const button of stateButtons) button.setAttribute('aria-pressed', String(button.dataset.state === state))
    if (stateText) stateText.innerHTML = STATE_TEXT[state] ?? ''
  }
  for (const button of stateButtons) button.addEventListener('click', () => setState(button.dataset.state ?? ''))
  eye?.querySelector('.trn-rotor')?.addEventListener('animationend', () => {
    if (eye.classList.contains('is-reset')) setState('')
  })
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-48) 0 var(--space-96);
  }

  /* Brand pattern: quarter discs of radius space-96 in a grid. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 0 55%;
    background: var(--line);
    opacity: 0.4;
    mask: url('/pattern.svg') 0 0 / 192px 192px;
    -webkit-mask: url('/pattern.svg') 0 0 / 192px 192px;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-48);
    align-items: center;
  }

  .hero-grid > *,
  .source > *,
  .pair > *,
  .stage > * {
    min-width: 0;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero h1 {
    margin: var(--space-16) 0 var(--space-24);
  }

  .accent {
    color: var(--malachite);
  }

  .lead {
    max-width: 52ch;
    margin: 0 0 var(--space-24);
    color: var(--muted);
    font-size: 17px;
  }

  .command {
    display: inline-flex;
    align-items: center;
    gap: var(--space-16);
    padding: 10px 10px 10px 18px;
    border-radius: var(--radius-md);
    background: var(--terminal-bg);
    color: var(--terminal-ink);
  }

  .command code {
    padding: 0;
    background: none;
    font-size: 16px;
  }

  .prompt {
    color: var(--glow);
  }

  .copy {
    padding: 6px 10px;
    border: 1px solid #3a4a44;
    border-radius: var(--radius-sm);
    background: transparent;
    color: #a6b8b2;
    font: 700 12px/1 var(--font-mono);
    cursor: pointer;
  }

  .copy:hover {
    color: var(--terminal-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    margin-top: var(--space-24);
  }

  .hint {
    margin: var(--space-8) 0 0;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }

  .section {
    padding-top: var(--space-96);
    padding-bottom: var(--space-48);
  }

  .section h2 {
    max-width: 24ch;
    margin: 0 0 var(--space-24);
  }

  .section-lead {
    max-width: var(--prose);
    margin: 0 0 var(--space-48);
    color: var(--muted);
  }

  .band {
    margin-top: var(--space-48);
    background: var(--surface);
  }

  .band .section {
    padding-bottom: var(--space-96);
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-24);
    margin: var(--space-48) 0;
    padding: 0;
    list-style: none;
  }

  .how-steps li {
    padding-top: var(--space-16);
    border-top: 3px solid var(--malachite);
  }

  .how-number {
    color: var(--muted);
    font-weight: 700;
    font-size: 13px;
  }

  .how-steps h3 {
    margin: var(--space-8) 0;
  }

  .how-steps p {
    margin: 0;
    color: var(--muted);
  }

  .source {
    display: grid;
    gap: var(--space-24);
    align-items: center;
  }

  @media (min-width: 860px) {
    .source {
      grid-template-columns: 3fr 2fr;
    }
  }

  .source-file {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .source-file .label {
    display: block;
    padding: 10px var(--space-16);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .source-file pre {
    margin: 0;
    border-radius: 0;
    font-size: 14px;
  }

  .md-h {
    color: var(--malachite-text);
    font-weight: 700;
  }

  .md-c {
    font-weight: 700;
  }

  .md-f {
    color: var(--muted);
  }

  .source-note {
    margin: 0;
    color: var(--muted);
  }

  .source-note strong {
    display: block;
    margin-bottom: var(--space-8);
    color: var(--ink);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-16);
    margin: var(--space-48) 0 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    padding: var(--space-24);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .glyph {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 0 8px;
    border-radius: var(--radius-md);
    background: var(--vortex);
    color: var(--glow);
    font-weight: 700;
  }

  .features h3 {
    margin: var(--space-16) 0 var(--space-8);
    font-size: 1.1rem;
  }

  .features p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-24);
  }

  .snippet {
    margin-top: var(--space-16);
    background: var(--surface);
    color: var(--muted);
    font-size: 13px;
  }

  .stage {
    display: grid;
    gap: var(--space-48);
    align-items: start;
  }

  @media (min-width: 860px) {
    .stage {
      grid-template-columns: 1fr 1fr;
    }
  }

  .keys {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px var(--space-24);
    margin: 0;
    align-items: center;
  }

  .keys dt {
    display: flex;
    gap: 6px;
    justify-content: flex-end;
  }

  .keys dd {
    margin: 0;
    color: var(--muted);
  }

  .table-scroll {
    overflow-x: auto;
    margin-bottom: var(--space-24);
  }

  table {
    min-width: 640px;
    background: var(--bg);
    border-radius: var(--radius-lg);
  }

  thead th {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  thead th:nth-child(2) {
    color: var(--malachite-text);
  }

  tbody th {
    width: 22%;
    font-size: 14px;
  }

  .muted {
    color: var(--muted);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .eye {
    display: grid;
    gap: var(--space-48);
    align-items: center;
  }

  @media (min-width: 860px) {
    .eye {
      grid-template-columns: auto 1fr;
    }
  }

  .eye-symbol {
    display: grid;
    place-items: center;
    width: 300px;
    height: 300px;
    max-width: 100%;
    justify-self: center;
    border-radius: 50%;
    background: var(--vortex);
  }

  .eye-symbol :global(.trn) {
    --trn-skull: #ffffff;
    --trn-eye: var(--vortex);
    max-width: 75%;
    height: auto;
  }

  .eye p {
    max-width: var(--prose);
  }

  .states {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: var(--space-24) 0 var(--space-16);
  }

  .states button {
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--ink);
    font: 700 14px/1 var(--font-mono);
    cursor: pointer;
  }

  .states button[aria-pressed='true'] {
    border-color: var(--malachite-deep);
    background: var(--malachite-deep);
    color: var(--on-malachite);
  }

  .state-text {
    min-height: 3.2em;
    color: var(--muted);
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-inline: auto;
  }

  .install {
    display: inline-block;
    max-width: 100%;
    margin: var(--space-24) auto var(--space-48);
    background: var(--terminal-bg);
    color: var(--terminal-ink);
    text-align: left;
  }

  .comment {
    color: #a6b8b2;
  }

  .cta .button {
    display: flex;
    width: fit-content;
    margin: 0 auto;
  }
</style>
