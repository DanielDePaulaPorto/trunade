---
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'
import Logo from '../components/Logo.astro'
import { CHROME, counterpart, langFromPath, localize } from '../i18n'

interface Props {
  title?: string
  description?: string
}

const path = Astro.url.pathname
const lang = langFromPath(path)
const text = CHROME[lang]
const { title, description = text.description } = Astro.props
const fullTitle = title ? `${title} · Trunade!` : text.homeTitle
const docsHref = localize('/docs/', lang)
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang={lang === 'pt' ? 'en' : 'pt-BR'} href={counterpart(path)} />
    <title>{fullTitle}</title>
    <script is:inline>
      // Before first paint: stored choice, else the system theme.
      try {
        const stored = localStorage.getItem('trunade-site-theme')
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
      } catch {
        document.documentElement.dataset.theme = 'light'
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#conteudo">{text.skip}</a>
    <header class="topbar wrap">
      <a class="home" href={localize('/', lang)} aria-label="Trunade!"><Logo height={30} /></a>
      <nav>
        <a href={docsHref} aria-current={path.startsWith(docsHref) ? 'page' : undefined}>{text.docs}</a>
        <a href={counterpart(path)} hreflang={lang === 'pt' ? 'en' : 'pt-BR'} aria-label={text.otherLangLabel}>{text.otherLang}</a>
        <button class="theme-toggle" type="button" aria-label={text.themeLabel}>
          <span class="when-light">{text.themeDark}</span><span class="when-dark">{text.themeLight}</span>
        </button>
      </nav>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <img src="/favicon.svg" alt="" width="22" height="22" />
        <p>{text.footer}</p>
      </div>
    </footer>

    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('trunade-site-theme', next)
        } catch {
          // keep working without persistence
        }
      })
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: var(--space-16);
    top: var(--space-16);
    z-index: 10;
    padding: var(--space-8) var(--space-16);
    background: var(--bg);
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .home {
    display: inline-flex;
  }

  nav {
    display: flex;
    gap: var(--space-24);
    align-items: center;
  }

  nav a,
  .theme-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: 400 14px/1 var(--font-mono);
    text-decoration: none;
    cursor: pointer;
  }

  nav a:hover,
  .theme-toggle:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  .theme-toggle::before {
    content: '$ ';
    color: var(--malachite-text);
  }

  .when-dark,
  :global([data-theme='dark']) .when-light {
    display: none;
  }

  :global([data-theme='dark']) .when-dark {
    display: inline;
  }

  .footer {
    margin-top: var(--space-96);
    padding: var(--space-48) 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  .footer-inner {
    display: flex;
    gap: var(--space-16);
    align-items: center;
  }

  .footer p {
    margin: 0;
  }
</style>
