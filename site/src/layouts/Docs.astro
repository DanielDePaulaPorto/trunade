---
import Base from './Base.astro'
import { langFromPath, localize } from '../i18n'

const { frontmatter } = Astro.props
const lang = langFromPath(Astro.url.pathname)
const TITLES = {
  pt: { docs: 'Documentação', previous: 'Anterior', next: 'Próxima', pages: ['Visão geral', 'Instalação', 'Escrevendo aulas', 'Recursos de aula', 'Na sala', 'Configuração'] },
  en: { docs: 'Docs', previous: 'Previous', next: 'Next', pages: ['Overview', 'Installation', 'Writing lessons', 'Lesson features', 'In class', 'Configuration'] },
}[lang]
const SLUGS = ['/docs/', '/docs/instalacao/', '/docs/aulas/', '/docs/recursos/', '/docs/sala/', '/docs/configuracao/']
const PAGES = SLUGS.map((slug, i) => ({ href: localize(slug, lang), title: TITLES.pages[i] }))
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const index = PAGES.findIndex((page) => page.href === path)
const previous = PAGES[index - 1]
const next = PAGES[index + 1]
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="wrap docs">
    <nav class="sidebar" aria-label={TITLES.docs}>
      <p class="label">{TITLES.docs}</p>
      <ol>
        {PAGES.map((page) => (
          <li><a href={page.href} aria-current={page.href === path ? 'page' : undefined}>{page.title}</a></li>
        ))}
      </ol>
    </nav>
    <article class="prose">
      <slot />
      <nav class="pager" aria-label={TITLES.docs}>
        {previous ? <a href={previous.href}><span class="label">{TITLES.previous}</span>{previous.title}</a> : <span />}
        {next && <a class="next" href={next.href}><span class="label">{TITLES.next}</span>{next.title}</a>}
      </nav>
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    gap: var(--space-48);
    padding-top: var(--space-24);
  }

  .docs > * {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .docs {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    .sidebar {
      position: sticky;
      top: var(--space-24);
      align-self: start;
    }
  }

  .sidebar ol {
    margin: var(--space-16) 0 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .sidebar a {
    display: block;
    margin-left: -1px;
    padding: 6px var(--space-16);
    border-left: 3px solid transparent;
    color: var(--muted);
    font-size: 15px;
    text-decoration: none;
  }

  .sidebar a:hover {
    color: var(--ink);
  }

  .sidebar a[aria-current='page'] {
    border-left-color: var(--malachite);
    color: var(--ink);
    font-weight: 700;
  }

  .prose {
    max-width: var(--prose);
  }

  .prose :global(h1) {
    margin: 0 0 var(--space-24);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
  }

  .prose :global(h2) {
    margin: var(--space-48) 0 var(--space-16);
    font-size: 1.6rem;
  }

  .prose :global(h3) {
    margin: var(--space-24) 0 var(--space-8);
  }

  .prose :global(li) {
    margin: 6px 0;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
  }

  .prose :global(blockquote) {
    margin: var(--space-24) 0;
    padding: var(--space-8) var(--space-16);
    border-left: 3px solid var(--bronze);
    background: var(--surface);
  }

  .prose :global(blockquote p) {
    margin: var(--space-8) 0;
  }

  .pager {
    display: flex;
    gap: var(--space-16);
    justify-content: space-between;
    margin-top: var(--space-96);
    padding-top: var(--space-24);
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px var(--space-16);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--malachite);
  }

  .pager .next {
    margin-left: auto;
    text-align: right;
  }
</style>
